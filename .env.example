# Copiar estos nombres en Netlify: Site configuration > Environment variables.
# Nunca subas los valores reales a GitHub.

SITE_URL=https://laquedioelmalpaso.com
CURSO_PRECIO=

# Supabase > Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago > Tus integraciones > tu aplicación > Credenciales de producción
MP_ACCESS_TOKEN=
# Mercado Pago > tu aplicación > Webhooks > Clave secreta
MP_WEBHOOK_SECRET=

# Bunny > Stream > tu biblioteca > API (Library ID) y Security (Token Authentication Key)
BUNNY_LIBRARY_ID=
BUNNY_TOKEN_KEY=
