# Copiar estos nombres en Netlify: Site configuration > Environment variables.
# Nunca subas los valores reales a GitHub.

SITE_URL=https://laquedioelmalpaso.com
CURSO_PRECIO=
# Precio en dólares para PayPal y cripto
CURSO_PRECIO_USD=

# Mails que pueden entrar al panel /curso/admin/ (separados por coma)
ADMIN_EMAILS=laquedioelmalpaso2020@gmail.com

# Supabase > Project Settings > Data API (sin /rest/v1/) y API Keys
SUPABASE_URL=https://xxxx.supabase.co
# Publishable key (sb_publishable_...)
SUPABASE_ANON_KEY=
# Secret key (sb_secret_...). Secreta.
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago > Tus integraciones > tu aplicación > Credenciales de producción
MP_ACCESS_TOKEN=
# Mercado Pago > tu aplicación > Webhooks > Clave secreta
MP_WEBHOOK_SECRET=

# Bunny > Stream > tu biblioteca > API (Library ID) y Security (Token Authentication Key)
BUNNY_LIBRARY_ID=
BUNNY_TOKEN_KEY=

# Transferencia bancaria (se muestra si hay alias o CBU)
TRANSFERENCIA_ALIAS=
TRANSFERENCIA_CBU=
TRANSFERENCIA_TITULAR=
TRANSFERENCIA_BANCO=

# PayPal > Developer > Apps & Credentials (modo Live)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# Poner "sandbox" sólo para pruebas
PAYPAL_ENV=live

# Cripto: dirección de tu billetera USDT y su red
CRIPTO_DIRECCION=
CRIPTO_RED=TRC20 (Tron)

# Aviso por mail cuando llega un comprobante (opcional, con Resend)
RESEND_API_KEY=
AVISOS_EMAIL=laquedioelmalpaso2020@gmail.com
